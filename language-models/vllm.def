Bootstrap: docker
From: vllm/vllm-openai:nightly

%post
    # vLLM and all dependencies come pre-installed in this image
    # Install any additional utilities you might need
    apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

%runscript
    #!/bin/bash
    echo "Command: $*"
    exec $*